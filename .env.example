# =====================================================================
# Personal Learning OS (LearnHouse fork): environment variables
# ---------------------------------------------------------------------
# PLACEHOLDERS ONLY. Never put real keys on the work laptop.
# Fill in real values on the personal homelab machine.
#
# `npx learnhouse dev` may generate its own env files (see apps/cli/src/templates/env.ts).
# If so, merge these values into them rather than keeping two sources.
# Variable names come from apps/api/config/config.py (upstream).
# Phase 0 TODO: confirm the accepted provider strings ("anthropic", "openai") in config.py.
# =====================================================================

# --- Core -------------------------------------------------------------
LEARNHOUSE_ENV=dev
LEARNHOUSE_DEVELOPMENT_MODE=true
LEARNHOUSE_SITE_NAME="Personal Learning OS"
LEARNHOUSE_DOMAIN=localhost
LEARNHOUSE_FRONTEND_DOMAIN=localhost:3000
LEARNHOUSE_PORT=1338
LEARNHOUSE_SELF_HOSTED=true
LEARNHOUSE_USE_DEFAULT_ORG=true
# Single personal org. Payments, email and analytics stay off by leaving their keys unset.
LEARNHOUSE_SAAS=false

# --- Database / cache (match the docker-compose service values) -------
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:<db-password>@localhost:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://localhost:6379/0

# --- Auth / internal secrets (generate with: openssl rand -hex 32) -----
LEARNHOUSE_AUTH_JWT_SECRET_KEY=<generate-random-64-hex>
COLLAB_INTERNAL_KEY=<generate-random-64-hex>
COLLAB_PORT=4000
LEARNHOUSE_API_URL=http://localhost:1338

# --- AI: chat (Anthropic) ---------------------------------------------
LEARNHOUSE_IS_AI_ENABLED=true
LEARNHOUSE_AI_PROVIDER=anthropic
LEARNHOUSE_AI_API_KEY=<your-anthropic-api-key>
LEARNHOUSE_AI_MODEL_FAST=claude-haiku-4-5
LEARNHOUSE_AI_MODEL_STANDARD=claude-sonnet-5-5
LEARNHOUSE_AI_MODEL_PRO=claude-opus-5-5

# --- AI: embeddings for pgvector RAG (OpenAI) -------------------------
LEARNHOUSE_AI_EMBEDDING_PROVIDER=openai
LEARNHOUSE_AI_EMBEDDING_MODEL=text-embedding-3-small
LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=<your-openai-api-key>

# --- Future features (Phase 2+) ---------------------------------------
# YouTube Data API v3: video metadata (title, channel, thumbnail)
YOUTUBE_API_KEY=<your-youtube-data-api-v3-key>
# GitHub fine-grained PAT, read-only public repos: repo/README ingestion
GITHUB_TOKEN=<your-github-read-only-token>

# --- Optional / later ---------------------------------------------------
# LEARNHOUSE_EMAIL_PROVIDER=resend
# LEARNHOUSE_RESEND_API_KEY=<your-resend-key>
# LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=<you@example.com>
# LEARNHOUSE_SENTRY_DSN=<your-sentry-dsn>
