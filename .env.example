# =====================================================================
# Personal Learning OS (LearnHouse fork): environment variables
# ---------------------------------------------------------------------
# PLACEHOLDERS ONLY. Real values live in ~/dev/learnhouse/apps/api/.env
# on DavidLab (WSL2 Ubuntu). Never commit real keys.
#
# How the files fit together (verified against learnhouse@dev 5e28b07):
#   - `npx learnhouse dev` checks three env files and, if vars are missing,
#     appends dev defaults (existing lines are kept):
#       apps/api/.env        LEARNHOUSE_AUTH_JWT_SECRET_KEY (random), COLLAB_INTERNAL_KEY
#       apps/web/.env.local  NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost:1338/
#       apps/collab/.env     COLLAB_PORT, LEARNHOUSE_API_URL, same JWT secret + internal key
#   - Everything else falls back to apps/api/config/config.yaml.
#     Env vars override YAML.
#   - The CLI sets LEARNHOUSE_DEVELOPMENT_MODE=true itself.
# This file documents what we ADD to apps/api/.env on top of that.
# =====================================================================

# --- Core -------------------------------------------------------------
LEARNHOUSE_SITE_NAME="Personal Learning OS"
# Single personal org. "single" is already the default on localhost.
LEARNHOUSE_TENANCY=single
LEARNHOUSE_SAAS=false
# Payments, email, Sentry and Tinybird stay off by leaving their vars unset.

# --- Database / cache: dev defaults from the CLI's compose file --------
# Only set these if you change the containers. Defaults:
# LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:learnhouse@localhost:5432/learnhouse
# LEARNHOUSE_REDIS_CONNECTION_STRING=redis://localhost:6379/learnhouse

# --- Auth / internal secrets: generated by the CLI ---------------------
# LEARNHOUSE_AUTH_JWT_SECRET_KEY=<generated, min 32 chars>
# COLLAB_INTERNAL_KEY=<dev default; change before exposing anything>

# --- AI: chat (Anthropic) ---------------------------------------------
LEARNHOUSE_IS_AI_ENABLED=true
LEARNHOUSE_AI_PROVIDER=anthropic
LEARNHOUSE_AI_API_KEY=<your-anthropic-api-key>
LEARNHOUSE_AI_MODEL_FAST=claude-haiku-4-5-20251001
LEARNHOUSE_AI_MODEL_STANDARD=claude-sonnet-5-5
LEARNHOUSE_AI_MODEL_PRO=claude-opus-5-5

# --- AI: embeddings for pgvector RAG (Google Gemini) --------------------
# Anthropic has no embeddings API. The pgvector column is Vector(768):
# changing dimensions needs a migration and a full re-index.
LEARNHOUSE_AI_EMBEDDING_PROVIDER=google
LEARNHOUSE_AI_EMBEDDING_MODEL=gemini-embedding-001
LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=768
LEARNHOUSE_GEMINI_API_KEY=<your-gemini-api-key>
# Proposed alternative (docs/DECISIONS.md D-006), local and free:
# LEARNHOUSE_AI_EMBEDDING_PROVIDER=ollama
# LEARNHOUSE_AI_EMBEDDING_MODEL=nomic-embed-text

# --- Future features (Phase 2+) ---------------------------------------
# YouTube Data API v3: video metadata (title, channel, thumbnail)
# YOUTUBE_API_KEY=<your-youtube-data-api-v3-key>
# GitHub fine-grained PAT, read-only public repos: repo/README ingestion
# GITHUB_TOKEN=<your-github-read-only-token>

# --- Optional / later ---------------------------------------------------
# LEARNHOUSE_EMAIL_PROVIDER=resend
# LEARNHOUSE_RESEND_API_KEY=<your-resend-key>
# LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=<you@example.com>
# LEARNHOUSE_SENTRY_DSN=<your-sentry-dsn>
